{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../voiceSession/**/*.ts",
    "../playback/playback-buffer.ts",
    "../playback/playout-clock.ts",
    "../playback/audio-mixer.ts",
    "../playback/probe-tone.ts",
    "../playback/audio-frames.ts",
    "../companionLink/**/*.ts"
  ]
}
