{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../src/userplugins/mvc/voiceSession/**/*.ts",
    "../src/userplugins/mvc/playback/playback-buffer.ts",
    "../src/userplugins/mvc/playback/playout-clock.ts",
    "../src/userplugins/mvc/playback/audio-mixer.ts",
    "../src/userplugins/mvc/playback/probe-tone.ts",
    "../src/userplugins/mvc/playback/audio-frames.ts",
    "../src/userplugins/mvc/companionLink/**/*.ts"
  ]
}
